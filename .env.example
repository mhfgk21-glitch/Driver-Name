# Configure these as environment variables in the hosting service. Do not commit
# real credentials. Passwords require 12+ characters with letters, numbers, and a symbol.
APP_ADMIN_USERNAME=admin_name
APP_ADMIN_PASSWORD=change-this-to-a-strong-password-2026!

# Optional: a bootstrap employee account. Further employee accounts are created
# in the authenticated user-management screen.
APP_EMPLOYEE_USERNAME=employee_name
APP_EMPLOYEE_PASSWORD=change-this-to-another-strong-password-2026!

# Idle session timeout in seconds (minimum 300, maximum 28800).
APP_SESSION_IDLE_SECONDS=1800
